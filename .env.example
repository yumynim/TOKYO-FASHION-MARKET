# ==========================================================
# 環境変数の一覧（値の実物はここに書かない）
# ==========================================================
# 使い方:
#   ローカルで /api をテストしたい場合だけ、このファイルをコピーして
#   ".env" という名前で保存し、値を埋める（.env は git に含まれません）。
#   本番（Vercel）は Project Settings → Environment Variables に
#   同じ名前で値を登録してください。コードやメモリには絶対に書かないこと。
# ==========================================================

# ---------- Supabase ----------
# フロント（js/config.js）にも同じ値を書く「公開してよい」情報
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...（anon / public key。RLSで保護される前提で公開可）

# サーバー専用・絶対に非公開（/api 配下でのみ使用）
SUPABASE_SERVICE_ROLE_KEY=eyJ...（service_role key。フロントに絶対出さない）

# ---------- Square ----------
# サーバー専用・絶対に非公開
SQUARE_ACCESS_TOKEN=EAAA...（Square開発者ダッシュボードで発行）
SQUARE_LOCATION_ID=L...（Squareの店舗/ロケーションID）
SQUARE_ENVIRONMENT=sandbox
# 本番公開時は SQUARE_ENVIRONMENT=production に変更し、
# 本番用の Access Token / Location ID に差し替える

# サーバー専用・絶対に非公開。Square Developer Dashboard → Webhooks で
# Notification URL（{SITE_URL}/api/webhooks/square）を登録した際に発行される
SQUARE_WEBHOOK_SIGNATURE_KEY=whsk_...

# ---------- Resend（購入確認メール） ----------
# サーバー専用・絶対に非公開
RESEND_API_KEY=re_...（resend.com で発行）
# 送信元アドレス。★独自ドメインをResendに接続したら、この値だけ認証済みドメインの
# アドレスに変更すればよい（コード側の変更は不要）
RESEND_FROM_EMAIL=noreply@example.com
# "true" の時だけ実際にメールを送信する本番スイッチ。それ以外（未設定含む）は常にスキップされる。
# 独自ドメイン接続 → RESEND_FROM_EMAILを認証済みアドレスに変更 → 最後にこれを true にする、の順で有効化する
RESEND_SEND_ENABLED=false

# ---------- サイトのURL（決済完了後の戻り先・Webhook署名検証にも使用） ----------
SITE_URL=https://tokyo-fashion-market.vercel.app

# ---------- 管理コンソール（/console） ----------
# サーバー専用・絶対に非公開。/console のログインパスワード（Supabaseの個人アカウントではなく
# 運営チームで共有する合言葉）。トークンの署名鍵も兼ねるため、ローテーションすると
# 発行済みトークンは全て自動的に無効になる
ADMIN_CONSOLE_PASSWORD=

# お問い合わせフォーム（/api/contact）の「届きました」通知メールの送り先。
# 未設定でも inquiries テーブルへの保存・/console からの一覧表示は動作するが、
# 見逃し防止の通知メールだけ届かなくなる
CONTACT_TO_EMAIL=

# /console の配信エディタで画像アップロードを使う場合、Supabase Storageに
# "announcement-images"（Public バケット）を事前に手動作成しておくこと。
# 未作成の間は画像アップロードだけ失敗する（他の機能には影響しない）

# ---------- 当日の入場確認（/checkin） ----------
# 当日スタッフ用の合言葉（任意）。これでログインすると /checkin だけ使える
# （/console のお問い合わせ・会員名簿・一斉配信には触れない）。
# 未設定なら ADMIN_CONSOLE_PASSWORD だけで /console と /checkin の両方が使える
CHECKIN_PASSWORD=

# 管理トークンの署名鍵（任意・推奨）。設定すると、トークンから合言葉を
# 総当たりで割り出す攻撃が不可能になる。ランダムな長い文字列を設定する
# （例: openssl rand -hex 32 で生成）。変更すると発行済みトークンは全て無効になる
ADMIN_TOKEN_SECRET=

# 今回のイベントの識別番号（例: 0927 = 9月27日開催）。受付コードの
# 「TFM-0927-1-XXXX」の真ん中部分になり、/checkin はこの値で
# 「今回のイベントのコードか」を判定する。イベントが決まったら設定する。
# 未設定でも動くが、その場合コードの識別部分は支払い確定日（YYYYMMDD）になる
CURRENT_EVENT_ID=

# 入場を受け付ける日（任意）。通常は設定不要（CURRENT_EVENT_IDが MMDD 形式なら
# そこから開催日を自動判定する）。テストで日付を変えたいときだけ
# YYYY-MM-DD で設定する。EVENT_DATE=any で日付チェック無効（テスト後は必ず消す）
EVENT_DATE=
